{
  "name": "dsh-english-lounge",
  "description": "English Lounge for the DeepSeek Harness: rotating word and phrase flashcards under the composer, plus an English topic brief with a word book in the right sidebar",
  "version": "1.5.0",
  "type": "module",
  "license": "MIT",
  "author": "Link <wmingzhou7@gmail.com>",
  "homepage": "https://github.com/wmingzhou7-cell/DSH-English-learning#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmingzhou7-cell/DSH-English-learning.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "english",
    "vocabulary",
    "flashcards",
    "learning"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
